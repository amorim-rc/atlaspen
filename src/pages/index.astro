---
// Página inicial — provisória. A versão final, com os contadores da base e a
// orientação por pergunta (Linha do tempo e tela inicial.dc.html, 5b), entra com
// o acervo e a linha do tempo.
import Base from '../layouts/Base.astro';
import {NOME} from '../site/config';
import {caminho} from '../site/url';

const secoes = [
  {nome: 'Tipos penais', rota: '/tipos', o_que: 'Todo tipo penal vigente, com a pena cominada e a simulação do que ela abre ou fecha.'},
  {nome: 'Atributos penais', rota: '/atributos', o_que: 'O percurso inverso: parta do instituto e veja quais tipos ele alcança, editando seus patamares.'},
  {nome: 'Acervo', rota: '/acervo', o_que: 'O que já foi crime no Brasil — revogado, vetado ou não recepcionado.'},
  {nome: 'Projeto', rota: '/projeto', o_que: 'Metodologia, completude, dados abertos, os robôs de conferência e as notas de atualização.'},
];
---

<Base titulo={NOME} descricao="Catálogo aberto de tipos e atributos penais brasileiros: a pena cominada de cada tipo e o que cada patamar de pena abre ou fecha ao condenado.">
  <section class="pagina abertura">
    <h1>AtlasPen — tipos e atributos penais</h1>
    <p>
      Toda pena cominada no direito brasileiro, e o que cada patamar de pena abre ou fecha ao condenado.
      Ferramenta de pesquisa mantida por um grupo independente; não é aconselhamento jurídico.
    </p>
    <ul class="secoes">
      {
        secoes.map((s) => (
          <li>
            <a href={caminho(s.rota)}>{s.nome}</a>
            <span>{s.o_que}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .abertura {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 3rem 1rem;
  }
  .abertura > p {
    max-width: 60ch;
    color: var(--cor-tinta-corpo);
  }
  .secoes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }
  .secoes li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--cor-borda);
    border-left: 3px solid var(--cor-acento);
    border-radius: 2px;
    background: var(--cor-superficie);
  }
  .secoes a {
    font-family: var(--fonte-serifa);
    font-size: 1.125rem;
    font-weight: 500;
  }
  .secoes span {
    font-size: var(--fs-pequeno);
    color: var(--cor-tinta-corpo);
  }
  @media (max-width: 560px) {
    .secoes li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }
</style>
