---
// Ficha do tipo penal — uma página estática por registro (/tipos/{id}),
// indexável e citável (design_handoff_atlaspen/09, item 1; Ficha do tipo
// penal.dc.html). O id é append-only e é a URL pública; nunca se reatribui.
//
// O que não depende da simulação é HTML do build: identificação, moldura, a
// faixa da última alteração, correlatos, auditoria. As abas de pena são uma
// ilha React, também renderizada no build — sem JS, a ficha mostra a moldura
// legal, os vereditos da lei vigente e os tipos correlatos.
import Base from '../../layouts/Base.astro';
import FichaTipo from '../../components/ficha/FichaTipo';
import PainelHistorico, {type DadosHistorico, type EventoResumo} from '../../components/ficha/PainelHistorico';
import {correlatosDe, fontesRemissaoDe, patamaresDe, todosOsTipos} from '../../site/catalogo-servidor';
import {diplomaDoRotulo} from '../../site/diplomas-servidor';
import {chaveDoArtigo, historicoDe, slugDoArtigo, type EventoHistorico} from '../../site/historico-servidor';
import {RESULTADOS_CONFERENCIA} from '../../site/servidor';
import {MODIFICADORES} from '../../lib/dosimetria';
import {modificadoresAplicaveis} from '../../lib/dosimetria/aplicaveis';
import {deslocaMoldura, paraOMotor} from '../../lib/dosimetria/moldura';
import {diasDeMeses, formatContagemDias} from '../../lib/pena';
import {dataCurta} from '../../site/datas';
import {caminho} from '../../site/url';
import {NOME, NOME_EXTENSO, SITE_URL} from '../../site/config';
import type {Crime} from '../../lib/types';

export function getStaticPaths() {
  return todosOsTipos().map((crime) => ({params: {id: String(crime.id)}, props: {crime}}));
}

const {crime} = Astro.props as {crime: Crime};
const diploma = diplomaDoRotulo(crime.lei);
const hist = historicoDe(crime.chave_dispositivo);
const vigente = crime.vigente !== false;
const calculavel = crime.tem_pena_privativa && !crime.pena_por_remissao;

// ── Marcas: os campos do tipo, em texto — nunca só em cor ──────────────────
type Marca = {rotulo: string; tom?: 'acento' | 'simulacao'; titulo?: string};
const acao = `Ação ${crime.acao.replace(/^Ação\s+Penal\s+/i, '').replace(/^Ação\s+/i, '').toLowerCase()}`;
const marcas: Marca[] = [
  ...(crime.pena_privativa !== 'Nenhuma' ? [{rotulo: crime.pena_privativa}] : []),
  ...(crime.tem_multa ? [{rotulo: `Multa ${crime.multa_regime}`}] : []),
  {rotulo: crime.elemento},
  ...(crime.violencia === 'Sim' ? [{rotulo: 'Com violência', tom: 'acento' as const}] : []),
  ...(crime.grave_ameaca === 'Sim' ? [{rotulo: 'Com grave ameaça', tom: 'acento' as const}] : []),
  ...(crime.tentativa === 'Sim' ? [{rotulo: 'Admite tentativa'}] : []),
  crime.acao_condicional
    ? {rotulo: `${acao} — depende do caso`, tom: 'simulacao' as const, titulo: crime.acao_condicao}
    : {rotulo: acao},
  ...(crime.hediondo === 'Sim' ? [{rotulo: 'Hediondo', tom: 'acento' as const}] : []),
  ...(crime.hediondo_condicional
    ? [{rotulo: 'Hediondez condicionada', tom: 'simulacao' as const, titulo: crime.hediondo_condicao}]
    : []),
  ...(crime.resultado_morte ? [{rotulo: 'Resultado morte'}] : []),
  ...(crime.contravencao ? [{rotulo: 'Contravenção penal'}] : []),
  ...(crime.infracao_menor_potencial ? [{rotulo: 'Menor potencial ofensivo'}] : []),
  ...(!vigente ? [{rotulo: 'Fora de vigência', tom: 'acento' as const}] : []),
  ...(crime.duplicata ? [{rotulo: 'Possível duplicata', tom: 'simulacao' as const}] : []),
];

// ── A moldura, nas três unidades ───────────────────────────────────────────
const dMin = diasDeMeses(crime.pena_min_meses);
const dMax = diasDeMeses(crime.pena_max_meses);
const meses = (m: number) => m.toLocaleString('pt-BR', {maximumFractionDigits: 2});
const especie = [
  crime.pena_privativa === 'Nenhuma' ? 'sem pena privativa' : crime.pena_privativa.toLowerCase(),
  crime.tem_multa ? `e multa (${crime.multa_regime})` : 'sem multa',
].join(' · ');

// ── A faixa da última alteração ────────────────────────────────────────────
// Lê o campo derivado do registro quando existir (frente 4), senão o histórico
// legislativo do artigo; não havendo nenhum dos dois, diz que não há.
type Faixa = {estado: 'normal' | 'fora' | 'nao-datado'; rotulo: string; texto: string; detalhe?: string; url?: string};
const semParenteses = (t: string) => t.replace(/^\(|\)$/g, '');
const artigoDoRegistro = chaveDoArtigo(crime.chave_dispositivo).split('|')[1] ?? crime.artigo;
let faixa: Faixa;
if (!vigente) {
  faixa = {
    estado: 'fora',
    rotulo: 'Fato anterior',
    texto: `Fora de vigência desde ${dataCurta(crime.vigencia_ate ?? '')}.`,
    detalhe: `${crime.vigencia_nota ?? ''} O registro continua consultável: fatos anteriores a essa data seguem regidos por ele.`,
  };
} else if (crime.ultima_alteracao !== undefined) {
  const u = crime.ultima_alteracao;
  const n = crime.alteracoes_legislativas;
  faixa = u
    ? {
        estado: 'normal',
        rotulo: 'Última alteração deste dispositivo',
        texto: `${u.evento === 'criacao' ? 'Incluído pela' : 'Redação dada pela'} ${u.norma ?? 'norma não identificada'}${u.ano ? `, de ${u.ano}` : ''}.`,
        ...(typeof n === 'number' ? {detalhe: `${n} ${n === 1 ? 'alteração legislativa' : 'alterações legislativas'} desde o texto original`} : {}),
        ...(u.url ? {url: u.url} : {}),
      }
    : {estado: 'nao-datado', rotulo: 'Última alteração deste dispositivo', texto: 'Sem data conhecida: o texto compilado não data esta redação.'};
} else if (hist.datado && (hist.ultima || hist.original)) {
  const u = hist.ultima;
  faixa = {
    estado: 'normal',
    rotulo: 'Última alteração deste dispositivo',
    texto: u
      ? `${semParenteses(u.anotacao ?? `Alterado pela ${u.norma}${u.ano ? `, de ${u.ano}` : ''}`)}.`
      : `Redação original${diploma ? ` — ${diploma.norma}` : ''}, sem alteração registrada.`,
    detalhe: `o ${artigoDoRegistro} como um todo tem ${hist.alteracoesArtigo} ${hist.alteracoesArtigo === 1 ? 'alteração registrada' : 'alterações registradas'}`,
    ...(u?.url ? {url: u.url} : {}),
  };
} else {
  faixa = {
    estado: 'nao-datado',
    rotulo: 'Última alteração deste dispositivo',
    texto: 'Ainda não datada.',
    detalhe:
      'o histórico legislativo dos tipos penais está em coleta (frente 4 do backlog); até lá, a ficha não afirma de quando é a redação',
  };
}

// ── O histórico do artigo, para a aba (ou para o bloco estático) ───────────
function tipoEvento(e: EventoHistorico): EventoResumo['tipo'] {
  if (e.evento === 'criacao') return e.norma === 'original' ? 'origem' : 'inclusao';
  if (e.evento === 'revogacao' || e.evento === 'renumeracao' || e.evento === 'transferencia') return e.evento;
  return 'alteracao';
}
const dadosHistorico: DadosHistorico = {
  artigo: `${crime.lei} · ${artigoDoRegistro}`,
  slugArtigo: slugDoArtigo(crime.chave_dispositivo),
  eventos: hist.eventosArtigo.map((e) => ({
    ano: e.ano ?? null,
    tipo: tipoEvento(e),
    norma: e.norma,
    dispositivo: e.dispositivo.split('|')[1] ?? e.dispositivo,
    ...(e.anotacao ? {anotacao: e.anotacao} : {}),
    ...(e.url ? {url: e.url} : {}),
  })),
};

// Escolhidos no build (escopo, condição, supressão do que já é linha do
// catálogo); à ilha vai só o que o motor lê.
const modificadores = calculavel
  ? modificadoresAplicaveis(MODIFICADORES, crime).filter(deslocaMoldura).map(paraOMotor)
  : [];
const patamares = patamaresDe(crime);
const correlatos = correlatosDe(crime);
const fontesRemissao = fontesRemissaoDe(crime);

// ── Auditoria e citação ───────────────────────────────────────────────────
const resultado = crime.conferido_resultado
  ? (RESULTADOS_CONFERENCIA[crime.conferido_resultado] ?? crime.conferido_resultado)
  : null;
const citacao =
  `${NOME} — ${NOME_EXTENSO}. ${crime.crime} (${crime.lei}, ${crime.artigo}). ` +
  'Disponível em: {url}. Acesso em: {acesso}.';

const titulo = `${crime.crime} — ${crime.artigo}, ${crime.lei}`;
const descricao =
  `${crime.artigo} (${diploma?.nome ?? crime.lei}). ` +
  (crime.tem_pena_privativa
    ? `Pena de ${crime.pena_faixa_rotulo}, ${crime.pena_privativa.toLowerCase()}. `
    : `${crime.pena_faixa_rotulo}. `) +
  'Os atributos penais que a pena cominada e a pena aplicada abrem ou fecham.';
const linkHistorico = calculavel && vigente ? '?modo=historico' : '#historico';
---

<Base titulo={titulo} descricao={descricao} ativo="tipos" tipoOg="article">
  <Fragment slot="head">
    <script is:inline>
      (function () {
        var m = new URLSearchParams(location.search).get('modo');
        if (m !== 'concreta' && m !== 'historico') m = 'cominada';
        document.documentElement.setAttribute('data-modo-ficha', m);
      })();
    </script>
  </Fragment>

  <div class="pagina ficha-pagina">
    <article class="cartao">
      <nav class="trilha" aria-label="Trilha">
        <ol>
          <li><a href={caminho('/tipos')}>Tipos penais</a></li>
          <li class="trilha-diploma"><a href={caminho(`/tipos?lei=${encodeURIComponent(crime.lei)}`)}>{diploma?.nome ?? crime.lei}</a></li>
          <li aria-current="page">{crime.artigo}</li>
        </ol>
      </nav>

      <header class="cabecalho-ficha">
        <div class="identidade">
          <p class="dispositivo">{crime.lei} · {crime.artigo}</p>
          <h1>{crime.crime}</h1>
          <details class="mais-sobre" open data-mais-sobre>
            <summary>mais sobre o tipo</summary>
            {crime.obs && <p class="texto-tipo">{crime.obs}</p>}
            <ul class="marcas" aria-label="Campos do tipo">
              {marcas.map((m) => <li class:list={['marca', m.tom && `marca-${m.tom}`]} title={m.titulo}>{m.rotulo}</li>)}
            </ul>
          </details>
        </div>

        {
          crime.pena_por_remissao ? (
            <div class="caixa-moldura">
              <span class="rotulo">Pena por remissão</span>
              <span class="valor-remissao">{crime.pena_por_remissao.dispositivo_fonte}</span>
              <span class="especie">
                {crime.pena_por_remissao.operador === 'nenhum'
                  ? 'a pena cominada lá, sem alteração'
                  : `com ${crime.pena_por_remissao.operador === 'aumento' ? 'aumento' : 'diminuição'} de ${crime.pena_por_remissao.fracao}`}
              </span>
            </div>
          ) : !crime.tem_pena_privativa ? (
            <div class="caixa-moldura">
              <span class="rotulo">{(crime.sancoes_nao_privativas ?? []).length ? 'Sanções cominadas' : 'Pena cominada'}</span>
              {(crime.sancoes_nao_privativas ?? []).length ? (
                <ul class="sancoes">
                  {crime.sancoes_nao_privativas.map((sn) => (
                    <li>
                      <span class="inciso">{sn.inciso}</span> {sn.sancao}
                    </li>
                  ))}
                </ul>
              ) : (
                <span class="valor-moldura">{crime.pena_faixa_rotulo}</span>
              )}
              <span class="especie">sem pena privativa de liberdade</span>
            </div>
          ) : (
            <div class="caixa-moldura">
              <span class="rotulo">Moldura da pena</span>
              <span class="valor-moldura num">{crime.pena_faixa_rotulo}</span>
              <span class="especie">{especie}</span>
              <span class="unidades num">
                {formatContagemDias(dMin).replace(/ dias?$/, '')} a {formatContagemDias(dMax)} · {meses(crime.pena_min_meses)} a {meses(crime.pena_max_meses)} meses
              </span>
            </div>
          )
        }
      </header>

      <section class:list={['faixa-alteracao', `faixa-${faixa.estado}`]} aria-label={faixa.rotulo}>
        <span class="rotulo rotulo-faixa">{faixa.rotulo}</span>
        <span class="corpo-faixa">
          <span class="texto-faixa">
            {faixa.url ? <a href={faixa.url} rel="noopener" target="_blank">{faixa.texto}</a> : faixa.texto}
          </span>
          {faixa.detalhe && <span class="detalhe-faixa">{faixa.detalhe}</span>}
        </span>
        {vigente && <a class="ver-historico nao-imprimir" href={linkHistorico}>ver histórico →</a>}
      </section>

      {
        calculavel ? (
          <FichaTipo
            client:load
            crime={crime}
            modificadores={modificadores}
            patamares={patamares}
            historico={vigente ? dadosHistorico : null}
          />
        ) : (
          <>
            <section class="sem-calculo">
              <h2>Por que esta ficha não calcula atributos</h2>
              {crime.pena_por_remissao ? (
                <p>
                  Este tipo não comina moldura própria: aplica a pena de {crime.pena_por_remissao.dispositivo_fonte}.
                  Como a moldura depende de qual dispositivo-fonte incide no caso, o catálogo não publica um número, e
                  o cálculo se faz no dispositivo aplicável — partir daqui, de uma moldura ausente, faria caber todo
                  atributo que depende de patamar de pena.
                </p>
              ) : (
                <p>
                  Este tipo não comina pena privativa de liberdade. Os atributos penais se medem por patamar de pena, e
                  um tipo sem pena privativa satisfaria qualquer teto: por isso ele fica fora dos vereditos e das
                  estatísticas de alcance, como na busca por atributo.
                </p>
              )}
              {fontesRemissao.length > 0 && (
                <ul class="lista-tipos">
                  {fontesRemissao.map((x) => (
                    <li>
                      <a href={caminho(`/tipos/${x.id}`)}>
                        <span class="artigo">{x.artigo}</span>
                        <span class="nome">{x.crime}</span>
                        <span class="faixa num">{x.pena_faixa_rotulo}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
            {vigente && <PainelHistorico dados={dadosHistorico} comoAba={false} />}
          </>
        )
      }

      {
        correlatos.length > 0 && (
          <section class="correlatos">
            <h2>Tipos correlatos</h2>
            <p class="nota-correlatos">Os outros dispositivos do mesmo artigo nesta lei.</p>
            <ul class="lista-tipos">
              {correlatos.map((x) => (
                <li>
                  <a href={caminho(`/tipos/${x.id}`)} data-preserva-modo>
                    <span class="artigo">{x.artigo}</span>
                    <span class="nome">
                      {x.crime}
                      {x.artigo === crime.artigo && <span class="dup"> · mesmo artigo: possível duplicata</span>}
                    </span>
                    <span class="faixa num">{x.pena_faixa_rotulo}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <footer class="pe">
        <div class="bloco-pe">
          {
            crime.hediondo_condicional && (
              <>
                <span class="rotulo">Hediondez condicionada ao caso</span>
                <p>
                  {crime.hediondo_condicao} A classificação depende de circunstância do caso, não do tipo: a ficha
                  mantém o padrão seguro — não hediondo — e mostra a hipótese. Marcar "hediondo neste caso" na aba de
                  pena concreta refaz as frações de progressão e de livramento.
                </p>
              </>
            )
          }
          {
            crime.acao_condicional && (
              <>
                <span class="rotulo">Ação penal condicionada ao caso</span>
                <p>{crime.acao_condicao}</p>
              </>
            )
          }
          <span class="rotulo">Como ler esta ficha</span>
          <p>
            Ferramenta de pesquisa: os vereditos aplicam a lei vigente ao que o catálogo registra do tipo, com as
            simplificações descritas na <a href={caminho('/projeto/metodologia')}>metodologia</a>. Não é
            aconselhamento jurídico.
          </p>
        </div>
        <div class="bloco-pe">
          <span class="rotulo">Auditoria do registro</span>
          <dl class="auditoria">
            <dt>id</dt>
            <dd>{crime.id}</dd>
            <dt>fonte</dt>
            <dd>
              {crime.fonte ? (
                <a href={crime.fonte} rel="noopener" target="_blank">planalto.gov.br · texto compilado</a>
              ) : (
                'não conferido ainda'
              )}
            </dd>
            <dt>conferido</dt>
            <dd>{crime.conferido_em ? dataCurta(crime.conferido_em) : 'não conferido ainda'}</dd>
            <dt>resultado</dt>
            <dd>{resultado ?? 'não conferido ainda'}</dd>
          </dl>
          <div class="acoes-pe nao-imprimir">
            <button type="button" class="botao-link" data-copiar-citacao data-citacao={citacao}>copiar citação</button>
            <details class="json">
              <summary>este registro em JSON</summary>
              <pre><code>{JSON.stringify(crime, null, 2)}</code></pre>
            </details>
          </div>
        </div>
      </footer>
    </article>
    <p class="endereco mono">{SITE_URL}tipos/{crime.id}</p>
  </div>

  <script is:inline>
    (function () {
      // "mais sobre o tipo": aberto na tela larga; no estreito, recolhido — quem
      // abriu a página já sabe qual tipo pediu.
      var d = document.querySelector('[data-mais-sobre]');
      if (d && window.matchMedia('(max-width: 640px)').matches) d.open = false;

      document.addEventListener('click', function (ev) {
        var alvo = ev.target.closest ? ev.target : null;
        if (!alvo) return;
        // Tipos correlatos levam a outra ficha preservando a aba ativa.
        var a = alvo.closest('a[data-preserva-modo]');
        if (a) {
          var m = new URLSearchParams(location.search).get('modo');
          if (m) {
            ev.preventDefault();
            location.href = a.getAttribute('href') + '?modo=' + encodeURIComponent(m);
          }
          return;
        }
        var b = alvo.closest('[data-copiar-citacao]');
        if (b) {
          var meses = ['jan.', 'fev.', 'mar.', 'abr.', 'maio', 'jun.', 'jul.', 'ago.', 'set.', 'out.', 'nov.', 'dez.'];
          var d2 = new Date();
          var texto = b.getAttribute('data-citacao')
            .replace('{url}', location.href)
            .replace('{acesso}', d2.getDate() + ' ' + meses[d2.getMonth()] + ' ' + d2.getFullYear());
          if (navigator.clipboard) {
            navigator.clipboard.writeText(texto).then(function () {
              b.textContent = 'citação copiada ✓';
              setTimeout(function () {
                b.textContent = 'copiar citação';
              }, 2000);
            });
          }
        }
      });
    })();
  </script>
</Base>

<style is:global>
  /* Antes da hidratação, só a aba pedida na URL aparece (o script do <head> marca
     o <html>). Sem JS, a marca não existe e as três vêm empilhadas. */
  html[data-modo-ficha='cominada'] [data-painel]:not([data-painel='cominada']),
  html[data-modo-ficha='concreta'] [data-painel]:not([data-painel='concreta']),
  html[data-modo-ficha='historico'] [data-painel]:not([data-painel='historico']) {
    display: none;
  }
</style>

<style>
  .ficha-pagina {
    padding-block: 1.5rem 0;
  }

  .cartao {
    border: 1px solid var(--cor-borda-forte);
    border-radius: var(--raio-cartao);
    background: var(--cor-papel);
    box-shadow: var(--sombra-cartao);
    overflow: clip;
  }

  .trilha {
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid var(--cor-borda);
    font-family: var(--fonte-mono);
    font-size: var(--fs-meta);
    color: var(--cor-tinta-fraca);
  }

  .trilha ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trilha li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--cor-tinta-fraca);
  }

  .trilha a {
    color: var(--cor-tinta-fraca);
    text-decoration: none;
  }

  .trilha a:hover {
    color: var(--cor-acento);
    text-decoration: underline;
  }

  .trilha [aria-current] {
    color: var(--cor-tinta-corpo);
  }

  .cabecalho-ficha {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem);
    gap: 1.75rem;
    padding: 1.4rem 1.25rem 1.25rem;
    border-bottom: 1px solid var(--cor-borda);
  }

  .identidade {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .dispositivo {
    font-family: var(--fonte-mono);
    font-size: var(--fs-meta);
    color: var(--cor-tinta-media);
  }

  h1 {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.35rem);
    line-height: 1.12;
  }

  .mais-sobre > summary {
    display: none;
  }

  .texto-tipo {
    margin-top: 0.6rem;
    font-family: var(--fonte-serifa);
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--cor-tinta-corpo);
    max-width: 62ch;
  }

  .marcas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .marca {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--cor-borda-forte);
    border-radius: 2px;
    background: var(--cor-superficie);
    color: var(--cor-tinta-corpo);
    font-family: var(--fonte-mono);
    font-size: var(--fs-rotulo);
    letter-spacing: 0.03em;
  }

  .marca-acento {
    border-color: color-mix(in srgb, var(--cor-acento) 45%, transparent);
    color: var(--cor-acento);
