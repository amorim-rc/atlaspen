---
// Linha do tempo da lei penal brasileira, de 1822 a hoje (Linha do tempo e tela
// inicial.dc.html, 5a). Lê os mesmos dados do acervo, e não uma transcrição à
// mão: corrigir a atribuição de uma revogação no acervo corrige a linha.
import Base from '../../layouts/Base.astro';
import LinhaDoTempo from '../../components/acervo/LinhaDoTempo';
import {INICIO_DA_LINHA, MARCOS, eventosDaLinha, registrosDoAcervo} from '../../site/acervo-servidor';
import {caminho} from '../../site/url';

const fim = new Date().getFullYear();
---

<Base
  titulo="Linha do tempo"
  descricao="A lei penal brasileira de 1822 a hoje: constituições, códigos e o que saiu de vigência, ano a ano."
  ativo="acervo"
>
  <header class="pagina cabecalho">
    <nav class="trilha" aria-label="Trilha"><a href={caminho('/acervo')}>Acervo histórico</a> / linha do tempo</nav>
    <h1>Linha do tempo</h1>
    <p class="intro">
      A lei penal brasileira de {INICIO_DA_LINHA} a hoje, em escala linear: cada ano ocupa a mesma largura, para que o
      volume legislativo recente apareça como é. Constituições acima do eixo, códigos abaixo; as barras contam os eventos
      que a base registra em cada ano — as saídas de vigência do acervo, a publicação dos diplomas revogados e as
      alterações dos dispositivos que os atributos penais citam.
    </p>
    <p class="nota">
      A cobertura é a da base, não a da história: ano sem barra é ano em que a base ainda não registra evento, e não ano
      sem lei penal.
    </p>
  </header>

  <div class="pagina corpo">
    <LinhaDoTempo client:load inicio={INICIO_DA_LINHA} fim={fim} marcos={MARCOS} eventos={eventosDaLinha()} registros={registrosDoAcervo()} />
  </div>
</Base>

<style>
  .cabecalho {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-block: 1.6rem 1.2rem;
  }
  .trilha {
    font-family: var(--fonte-mono);
    font-size: var(--fs-meta);
    color: var(--cor-tinta-fraca);
  }
  .trilha a {
    color: var(--cor-tinta-fraca);
  }
  .intro {
    max-width: 66ch;
    line-height: 1.65;
    color: var(--cor-tinta-corpo);
  }
  .nota {
    max-width: 66ch;
    font-family: var(--fonte-mono);
    font-size: var(--fs-rotulo);
    color: var(--cor-tinta-fraca);
  }
  .corpo {
    padding-bottom: 1rem;
  }
</style>
