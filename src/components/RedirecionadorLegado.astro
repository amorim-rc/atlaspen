---
// Stub de uma rota antiga (01-arquitetura-da-informacao.md, "Camada de
// redirecionamento"). Página mínima, sem o layout do site: lê a query, monta o
// destino pela regra e faz `location.replace` — o histórico do navegador não
// guarda o endereço morto. Sem JS, o <meta refresh> leva ao destino sem os
// parâmetros, e o link visível resolve o resto.
//
// A lógica abaixo é a mesma de `destinoDe` em src/site/redirecionamentos.ts, e o
// teste de fumaça (scripts/verificar_rotas.mjs) EXECUTA este script, tirado do
// HTML publicado, contra a função — as duas não podem divergir.
import type {Redirecionamento} from '../site/redirecionamentos';
import {caminho} from '../site/url';

interface Props {
  regra: Redirecionamento;
}

const {regra} = Astro.props;
const base = caminho('/');
const destino = caminho(regra.para);
const absoluto = new URL(destino, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Este endereço mudou · AtlasPen</title>
    <link rel="canonical" href={absoluto} />
    <noscript><meta http-equiv="refresh" content={`0; url=${destino}`} /></noscript>
    <script is:inline data-redirecionador define:vars={{regra, base}}>
      var q = new URLSearchParams(location.search);
      var rota = regra.para;
      if (regra.parametro) {
        var valor = q.get(regra.parametro.nome);
        if (valor) {
          rota = regra.parametro.para.replace('{valor}', encodeURIComponent(valor));
          q.delete(regra.parametro.nome);
        }
      }
      var resto = q.toString();
      location.replace(base + rota.replace(/^\/+/, '') + (resto ? '?' + resto : '') + location.hash);
    </script>
  </head>
  <body>
    <p>Este endereço mudou. <a href={destino}>Seguir para o novo endereço</a>.</p>
  </body>
</html>
