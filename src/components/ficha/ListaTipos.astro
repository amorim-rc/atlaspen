---
// A lista de tipos que a ficha aponta — os dispositivos de origem da pena por
// remissão, os tipos correlatos: artigo, nome e faixa de pena, cada linha um
// link para a outra ficha. Uma lista só para as duas seções, para o estilo de
// linha não viver em dois lugares.
import type {Crime} from '../../lib/types';
import {caminho} from '../../site/url';

interface Props {
  itens: Crime[];
  /** O link leva à outra ficha preservando a aba ativa (o script da página lê o atributo). */
  preservaModo?: boolean;
  /** O artigo do tipo desta ficha: o correlato de mesmo artigo é marcado como possível duplicata. */
  artigoAtual?: string;
}
const {itens, preservaModo = false, artigoAtual} = Astro.props;
---

<ul class="lista-tipos">
  {itens.map((x) => (
    <li>
      <a href={caminho(`/tipos/${x.id}`)} data-preserva-modo={preservaModo ? '' : undefined}>
        <span class="artigo">{x.artigo}</span>
        <span class="nome">
          {x.crime}
          {artigoAtual !== undefined && x.artigo === artigoAtual && <span class="dup"> · mesmo artigo: possível duplicata</span>}
        </span>
        <span class="faixa num">{x.pena_faixa_rotulo}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .lista-tipos {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .lista-tipos a {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: baseline;
    min-height: var(--alvo-toque);
    padding: 0.6rem 0.3rem;
    border-bottom: 1px solid var(--cor-borda);
    color: var(--cor-tinta);
    text-decoration: none;
  }

  .lista-tipos a:hover {
    background: var(--cor-papel-alt);
  }

  .lista-tipos .artigo,
  .lista-tipos .faixa {
    font-family: var(--fonte-mono);
    font-size: var(--fs-meta);
    color: var(--cor-tinta-media);
  }

  .lista-tipos .nome {
    font-family: var(--fonte-serifa);
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .dup {
    font-family: var(--fonte-mono);
    font-size: var(--fs-rotulo);
    color: var(--cor-simulacao);
  }

  @media (max-width: 760px) {
    .lista-tipos a {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
