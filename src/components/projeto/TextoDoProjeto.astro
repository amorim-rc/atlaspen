---
// Um texto de textos/ em coluna de leitura: gênero, título, data, assinatura e o
// corpo. É o que /projeto (a história) e /projeto/creditos (a autoria) mostram, e
// por isso mora aqui, e não duplicado em cada página.
import {getEntry, render} from 'astro:content';
import {dataExtenso} from '../../site/datas';
import '../../styles/prosa.css';

interface Props {
  /** O nome do arquivo em textos/, sem a extensão. */
  id: string;
}
const {id} = Astro.props;
const texto = await getEntry('textos', id);
if (!texto) throw new Error(`textos/${id}.md não encontrado`);
const {Content} = await render(texto);
const t = texto.data;
---

<article class="texto">
  <header class="topo-texto">
    <p class="genero sem-recuo">{t.genero}</p>
    <h2>{t.titulo}</h2>
    <p class="meta sem-recuo">
      {dataExtenso(t.data)}
      {t.revisado_em && <> · revisado em {dataExtenso(t.revisado_em)}</>}
      {' · '}{t.assinatura}
    </p>
  </header>
  <div class="prosa leitura"><Content /></div>
</article>

<style>
  .texto {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .topo-texto {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: var(--largura-leitura);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--cor-borda);
  }
  .genero {
    font-family: var(--fonte-mono);
    font-size: var(--fs-rotulo);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cor-acento);
  }
  /* O título ocupa a largura do texto abaixo dele, sem a quebra equilibrada. */
  .topo-texto h2 {
    font-size: var(--fs-titulo-1);
    line-height: 1.2;
    text-wrap: wrap;
  }
  .meta {
    font-family: var(--fonte-mono);
    font-size: var(--fs-meta);
    color: var(--cor-tinta-fraca);
  }
</style>
