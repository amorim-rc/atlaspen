{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": false,
    "outDir": "../.verificar-build",
    "rootDir": ".."
  },
  "include": [
    "verificar_atributos.ts",
    "equivalencia_atributos.ts",
    "derivar_atributos.ts",
    "../src/lib/**/*.ts"
  ],
  "exclude": [
    "../src/lib/useCrimes.ts"
  ]
}
