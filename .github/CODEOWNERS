/tsconfig.json                  @amorim-rc
/package.json                   @amorim-rc
/package-lock.json              @amorim-rc

# Infra, CI/CD e automações, inclusive este arquivo         (mantido no mantenedor)
/.github/                       @amorim-rc

# Licença e citação acadêmica                               (mantido no mantenedor)
/LICENSE                        @amorim-rc
